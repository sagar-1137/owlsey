# Cloudflare Web Analytics (cookie-less). Get the token from the Cloudflare
# dashboard: Analytics & Logs → Web Analytics → Add a site → owlsey.com.
# Leave empty to disable analytics (nothing is loaded).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# The contact form posts to /api/contact, a Cloudflare Pages Function.
# Set these as Pages runtime Variables and Secrets, not NEXT_PUBLIC_* values:
# OWLSEY_CONSOLE_API_URL=https://cms.owlsey.com
# OWLSEY_CONSOLE_PRODUCT_KEY=<secret product key issued in Owlsey Console>
