# Cloudflare Web Analytics (cookie-less). Get the token from the Cloudflare
# dashboard: Analytics & Logs → Web Analytics → Add a site → owlsey.com.
# Leave empty to disable analytics (nothing is loaded).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Contact form delivery (optional). Any endpoint that accepts a JSON POST —
# e.g. Web3Forms, Formspree, or a Cloudflare Pages Function. Leave empty and
# the form hands the brief to the visitor's email app / clipboard instead.
NEXT_PUBLIC_FORM_ENDPOINT=
